<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/linearLayoutForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitluForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formular Adăugare Hangar (Hozu Gabriel)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- TextView & EditText for Nume -->
        <TextView
            android:id="@+id/tvNume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nume Hangar:" />

        <EditText
            android:id="@+id/etNume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduceți numele"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <!-- TextView & EditText for Capacitate -->
        <TextView
            android:id="@+id/tvCapacitate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capacitate:" />

        <EditText
            android:id="@+id/etCapacitate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduceți capacitatea (număr)"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <!-- CheckBox -->
        <CheckBox
            android:id="@+id/cbDisponibil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Este disponibil"
            android:layout_marginBottom="12dp" />

        <!-- RadioGroup & RadioButton -->
        <TextView
            android:id="@+id/tvTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tip Hangar:" />

        <RadioGroup
            android:id="@+id/rgTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbAvioane"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avioane"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbElicoptere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elicoptere"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <!-- Spinner -->
        <TextView
            android:id="@+id/tvLocatie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Locație:" />

        <Spinner
            android:id="@+id/spLocatie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- RatingBar -->
        <TextView
            android:id="@+id/tvRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating:" />

        <RatingBar
            android:id="@+id/rbRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:rating="3.5"
            android:stepSize="0.5"
            android:layout_marginBottom="12dp" />

        <!-- Switch -->
        <Switch
            android:id="@+id/swPaza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Are pază permanentă"
            android:layout_marginBottom="20dp" />

        <!-- Button -->
        <Button
            android:id="@+id/btnSalveaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvează Obiect" />

    </LinearLayout>
</ScrollView>
