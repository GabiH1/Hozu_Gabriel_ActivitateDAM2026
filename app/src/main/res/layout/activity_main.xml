<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitluMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seminar 4 - Hozu Gabriel"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnAdauga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adaugă Hangar"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvRezultatHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Obiectul primit:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvRezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Niciun obiect adăugat încă."
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#EEEEEE" />

</LinearLayout>
