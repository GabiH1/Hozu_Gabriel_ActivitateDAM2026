<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="20dp"
    tools:context=".AddHangarActivityAI">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#4C51BF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTitluFormAI"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Adăugare Hangar (AI Design)"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Formular inteligent de înregistrare hangar nouă"
                    android:textColor="#E0E7FF"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Form Container Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Nume -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nume Hangar"
                    android:textColor="#374151"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etNume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:hint="Ex: Hangar Alpha 1"
                    android:background="@android:drawable/editbox_background"
                    android:padding="12dp"
                    android:textSize="16sp" />

                <!-- Capacitate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capacitate (număr)"
                    android:textColor="#374151"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etCapacitate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:hint="Ex: 25"
                    android:inputType="number"
                    android:background="@android:drawable/editbox_background"
                    android:padding="12dp"
                    android:textSize="16sp" />

                <!-- Disponibilitate -->
                <CheckBox
                    android:id="@+id/cbDisponibil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Este Disponibil?"
                    android:textSize="16sp"
                    android:textColor="#374151" />

                <!-- Tip Hangar -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tip Hangar"
                    android:textColor="#374151"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/rgTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbAvioane"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avioane"
                        android:checked="true"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbElicoptere"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="Elicoptere"
                        android:textSize="15sp" />
                </RadioGroup>

                <!-- Locatie -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Locație"
                    android:textColor="#374151"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spLocatie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:padding="8dp" />

                <!-- Rating -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calitate / Rating"
                    android:textColor="#374151"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <RatingBar
                    android:id="@+id/rbRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:numStars="5"
                    android:rating="4"
                    android:stepSize="0.5" />

                <!-- Paza -->
                <Switch
                    android:id="@+id/swPaza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="Pază Permanentă?"
                    android:textColor="#374151"
                    android:textSize="16sp" />

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btnSalvareDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#4C51BF"
                    android:text="💾 Salvează Hangar (AI)"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:onClick="culegeDate" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
