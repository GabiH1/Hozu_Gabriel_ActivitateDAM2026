<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">


    <Button
        android:id="@+id/btnDeschidereActivitateAdaugare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adauga hangar"
        android:onClick="deschideActivitateAdaugare"
        />

    <Button
        android:id="@+id/btnDeschidereActivitateAdaugareAI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Adauga hangar (AI Design)"
        android:backgroundTint="#4C51BF"
        android:textColor="@android:color/white"
        android:onClick="deschideActivitateAdaugareAI"
        />

    <Button
        android:id="@+id/btnDeschidereListaHangare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lista Hangare"
        android:onClick="deschideActivitate3"
        />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />



</LinearLayout>
