<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AddHangarActivity">

    <LinearLayout
        android:id="@+id/linearLayoutForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitluForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formular Hangar nou"
            android:textSize="25sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvNume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nume Hangar:" />

        <EditText
            android:id="@+id/textNume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nume Hangar"
            android:textSize="20sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvCapacitate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capacitate Hangar:" />

        <EditText
            android:id="@+id/textCapacitate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Capacitate Hangar"
            android:inputType="number"
            android:textSize="20sp"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/checkBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:text="Este Disponibil?"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tip Hangar:" />

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbAvioane"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avioane"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbElicoptere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elicoptere"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvLocatie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Locatie:" />

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rating Hangar"
            android:textSize="20sp" />

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switch1"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Are Paza?"
            android:textSize="20sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSalvareDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salveaza Hangar"
            android:onClick="culegeDate" />

    </LinearLayout>
</ScrollView>
