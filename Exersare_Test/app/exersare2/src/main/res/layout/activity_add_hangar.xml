<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AddHangar">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Formular Hangar"
        android:textSize="25dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nume Hangar:" />

    <EditText
        android:id="@+id/numeET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="Nume Hangar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Capacitate:" />

    <EditText
        android:id="@+id/capacitateET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="Capacitate Hangar" />

    <CheckBox
        android:id="@+id/disponibilCB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Este disponibil?" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tip Hangar:" />

    <RadioGroup
        android:id="@+id/RadioGrup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/avioaneRB"
            android:layout_width="128dp"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Avioane" />


        <RadioButton
            android:id="@+id/elicoptereRB"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:text="Elicoptere" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Locatie:" />

    <Spinner

        android:id="@+id/spinner1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rating Hanagar" />

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="245dp"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="0.5" />
    <Switch
        android:id="@+id/switch1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are Paza?"
        />
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salveaza Hangar"
        android:onClick="SalveazaHangar" />
</LinearLayout>