<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AddZborActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Companie:"
        />
    <EditText
        android:id="@+id/etCompanie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nume Companie"
        android:inputType="text"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nr locuri:"
        />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/etNrLocuri"
        android:hint="Nr locuri"
        android:inputType="number"
        />
    <CheckBox
        android:id="@+id/cbDirect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Este direct?"
        />
    <Spinner
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/spDestinatie"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pret:"
        />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/etPret"
        android:hint="Pret"
        android:inputType="number"
        />
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salveaza Zbor"
        android:onClick="SalveazaZbor"
        />
</LinearLayout>